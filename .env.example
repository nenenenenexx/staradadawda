# Add these privately in Vercel > Project > Settings > Environment Variables.
# For local development, copy this file to .env.local and fill it in.

# Stripe: server-side secret key used to look up Checkout Sessions and write
# fulfillment metadata. No publishable key or webhook secret is required.
STRIPE_SECRET_KEY=

# KeyAuth Seller API key and per-plan subscription level + expiry.
# Levels and expiries are NOT Stripe values. Confirm both against your KeyAuth
# application's own configuration before going live.
KEYAUTH_SELLER_KEY=
KEYAUTH_MONTHLY_LEVEL=
KEYAUTH_QUARTERLY_LEVEL=
KEYAUTH_LIFETIME_LEVEL=
KEYAUTH_MONTHLY_EXPIRY=30
KEYAUTH_QUARTERLY_EXPIRY=90
# Set the lifetime expiry value your KeyAuth application uses. No guessed default.
KEYAUTH_LIFETIME_EXPIRY=

# HTTPS download URL for the loader. Fetched by the server only; use private
# storage with authentication so a leaked URL does not distribute the file.
LOADER_URL=https://github.com/nenenenenexx/strade.cc/releases/download/strade/Strade.exe
LOADER_BEARER_TOKEN=
LOADER_FILENAME=Strade.exe
